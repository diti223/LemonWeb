---
import { createLemonWebApplication } from "../../infrastructure/composition-root.ts";
import RecipeLayout from "../../layouts/RecipeLayout.astro";
import RecipeJsonLd from "../../components/RecipeJsonLd.astro";
import RecipeHero from "../../components/RecipeHero.astro";
import IngredientList from "../../components/IngredientList.astro";
import InstructionList from "../../components/InstructionList.astro";
import NutritionSummary from "../../components/NutritionSummary.astro";
import NotesSection from "../../components/NotesSection.astro";
import OpenInLemonCTA from "../../components/OpenInLemonCTA.astro";
import PrintStyles from "../../components/PrintStyles.astro";

export const prerender = false;

const { slug } = Astro.params;
const application = createLemonWebApplication();
const recipe = await application.getPublishedRecipe.execute(slug!);

if (!recipe) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const canonicalUrl = recipe.canonicalUrl;
---

<RecipeLayout
  title={recipe.title}
  description={recipe.description}
  imageUrl={recipe.imageUrl}
  canonicalUrl={canonicalUrl}
  jsonUrl={recipe.jsonUrl}
>
  <PrintStyles />
  <RecipeJsonLd
    title={recipe.title}
    description={recipe.description}
    servings={recipe.servings}
    ingredientTexts={recipe.ingredientDisplayTexts}
    instructions={[...recipe.instructions]}
    nutrition={recipe.nutrition}
    imageUrl={recipe.imageUrl}
    canonicalUrl={canonicalUrl}
  />

  <RecipeHero title={recipe.title} imageUrl={recipe.imageUrl} />

  {recipe.description && (
    <p class="mb-8 text-[var(--lemon-text-secondary)] leading-relaxed">{recipe.description}</p>
  )}

  {recipe.servings && (
    <p class="mb-6 text-sm text-[var(--lemon-text-secondary)]">Servings: {recipe.servings}</p>
  )}

  <IngredientList ingredientTexts={recipe.ingredientDisplayTexts} />
  <InstructionList instructions={[...recipe.instructions]} />

  <NotesSection notes={[...recipe.notes]} />

  {recipe.nutrition && <NutritionSummary nutrition={recipe.nutrition} />}

  <OpenInLemonCTA canonicalUrl={canonicalUrl} />
</RecipeLayout>
