---
import { LEMON_APP_STORE_URL, buildLemonRecipeOpenUrl } from "../lib/lemon-app.ts";

interface Props {
  canonicalUrl: string;
}

const { canonicalUrl } = Astro.props;
const appOpenUrl = buildLemonRecipeOpenUrl(canonicalUrl);
---

<footer class="no-print mt-12 pt-6 text-center">
  <a
    href={appOpenUrl}
    class="inline-flex items-center gap-2 rounded-full bg-[var(--lemon-accent)] px-8 py-3 font-semibold text-[#020202] transition hover:bg-[var(--lemon-accent-hover)]"
  >
    Open in Lemon
  </a>
  <p class="mt-3 text-sm text-[var(--lemon-text-secondary)]">
    Don't have the app?
    <a
      href={LEMON_APP_STORE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="underline hover:text-white"
    >
      Get it on the App Store
    </a>
  </p>
</footer>
