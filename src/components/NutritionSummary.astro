---
interface Props {
  nutrition: {
    calories: number;
    proteins: number;
    fats: number;
    carbohydrates: number;
  };
  servings: number;
}

const { nutrition, servings } = Astro.props;
const divisor = servings > 0 ? servings : 1;
const perServingNutrition = {
  calories: Math.round(nutrition.calories / divisor),
  proteins: Math.round(nutrition.proteins / divisor),
  fats: Math.round(nutrition.fats / divisor),
  carbohydrates: Math.round(nutrition.carbohydrates / divisor),
};
---

<section class="mb-8">
  <h2 class="mb-4 text-xl font-semibold text-white">Nutrition per serving</h2>
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded-xl bg-[var(--lemon-surface-tertiary)] p-4 text-center">
      <p class="text-2xl font-bold text-white">{perServingNutrition.calories}</p>
      <p class="mt-1 text-sm text-[var(--lemon-text-secondary)]">kcal</p>
    </div>
    <div class="rounded-xl bg-[var(--lemon-surface-tertiary)] p-4 text-center">
      <div class="mx-auto mb-2 h-2 w-2 rounded-full bg-[var(--lemon-protein)]"></div>
      <p class="text-2xl font-bold text-white">{perServingNutrition.proteins}g</p>
      <p class="mt-1 text-sm text-[var(--lemon-text-secondary)]">Protein</p>
    </div>
    <div class="rounded-xl bg-[var(--lemon-surface-tertiary)] p-4 text-center">
      <div class="mx-auto mb-2 h-2 w-2 rounded-full bg-[var(--lemon-fat)]"></div>
      <p class="text-2xl font-bold text-white">{perServingNutrition.fats}g</p>
      <p class="mt-1 text-sm text-[var(--lemon-text-secondary)]">Fat</p>
    </div>
    <div class="rounded-xl bg-[var(--lemon-surface-tertiary)] p-4 text-center">
      <div class="mx-auto mb-2 h-2 w-2 rounded-full bg-[var(--lemon-carbs)]"></div>
      <p class="text-2xl font-bold text-white">{perServingNutrition.carbohydrates}g</p>
      <p class="mt-1 text-sm text-[var(--lemon-text-secondary)]">Carbs</p>
    </div>
  </div>
</section>
