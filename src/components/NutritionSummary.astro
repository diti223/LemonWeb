---
interface Props {
  nutrition: {
    calories: number;
    proteins: number;
    fats: number;
    carbohydrates: number;
  };
}

const { nutrition } = Astro.props;
---

<section class="mb-8">
  <h2 class="mb-3 text-xl font-semibold">Nutrition</h2>
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded-lg bg-gray-50 p-3 text-center">
      <p class="text-lg font-medium">{nutrition.calories}</p>
      <p class="text-sm text-gray-500">kcal</p>
    </div>
    <div class="rounded-lg bg-gray-50 p-3 text-center">
      <p class="text-lg font-medium">{nutrition.proteins}g</p>
      <p class="text-sm text-gray-500">Protein</p>
    </div>
    <div class="rounded-lg bg-gray-50 p-3 text-center">
      <p class="text-lg font-medium">{nutrition.fats}g</p>
      <p class="text-sm text-gray-500">Fat</p>
    </div>
    <div class="rounded-lg bg-gray-50 p-3 text-center">
      <p class="text-lg font-medium">{nutrition.carbohydrates}g</p>
      <p class="text-sm text-gray-500">Carbs</p>
    </div>
  </div>
</section>
