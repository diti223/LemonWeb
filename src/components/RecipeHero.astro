---
interface Props {
  title: string;
  imageUrl?: string;
}

const { title, imageUrl } = Astro.props;
---

<header class="mb-8">
  {
    imageUrl && (
      <img
        src={imageUrl}
        alt={title}
        class="mb-6 aspect-[16/10] w-full rounded-lg object-cover"
      />
    )
  }
  <h1 class="text-3xl font-bold leading-tight sm:text-4xl">{title}</h1>
</header>
