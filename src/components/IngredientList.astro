---
interface Props {
  title?: string;
  ingredientTexts: readonly string[];
}

const { title = "Ingredients", ingredientTexts } = Astro.props;
---

<section class="mb-8 bg-[var(--lemon-surface)] rounded-2xl p-6">
  <h2 class="mb-4 text-xl font-semibold text-white">{title}</h2>
  <ul class="space-y-3">
    {ingredientTexts.map((text) => (
      <li class="text-[var(--lemon-text)] border-b border-white/5 pb-3 last:border-0 last:pb-0">
        {text}
      </li>
    ))}
  </ul>
</section>
